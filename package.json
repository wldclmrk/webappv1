{
  "name": "weldclass-web",
  "version": "1.0.0",
  "private": true,
  "description": "Weldclass website (Version A design) built with Next.js for Vercel.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/netsuite-snapshot.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "netsuite:snapshot": "node scripts/netsuite-snapshot.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "next": "16.4.3",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
