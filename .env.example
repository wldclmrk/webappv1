# Copy to .env.local for local development, and add the same variables in Vercel (Project > Settings > Environment Variables).

# Public site address, used for canonical URLs, sitemaps and structured data.
NEXT_PUBLIC_SITE_URL=https://www.weldclass.com.au

# Form emails (contact, batch certificate and dealer applications) are sent with Resend (resend.com).
# Without a key, submissions are only written to the Vercel function log.
RESEND_API_KEY=
FORM_TO_EMAIL=sales@weldclass.com.au
FORM_FROM_EMAIL=Weldclass Website <website@weldclass.com.au>

# Dealer login: where the dealer login form sends people (for example a NetSuite customer portal).
# Leave blank to show a "contact us" message instead of the login form.
NEXT_PUBLIC_DEALER_LOGIN_URL=

# Set to "true" on preview deployments to stop search engines indexing them.
NOINDEX=

# NetSuite (OAuth 2.0 M2M certificate). Sandbox values go in the Vercel Preview environment only.
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CERT_ID=
NETSUITE_PRIVATE_KEY=
# "netsuite" reads products from NetSuite; unset or anything else keeps the JSON content.
PRODUCT_SOURCE=

# Dealer portal. Turns on when NetSuite is connected and PORTAL_SECRET is set (make one with: openssl rand -base64 32).
PORTAL_SECRET=
# Optional: only customers in these NetSuite customer category IDs can sign in, e.g. 3,7. Blank allows any active customer.
PORTAL_CUSTOMER_CATEGORIES=
# The portal PDF RESTlet's script and deployment IDs, e.g. customscript_wc_portal&deploy=customdeploy_wc_portal
NETSUITE_PORTAL_RESTLET=
# Dealer portal accounts database (Postgres). Added automatically when you connect Neon from the Vercel Marketplace.
DATABASE_URL=
